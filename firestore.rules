rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile: user can read their profile, update basic info (cannot directly write credits)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.credits == 100;
      allow update: if isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['credits']));
      allow delete: if false;
    }

    // Projects: owned by the user
    match /projects/{projectId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      
      // Project Scenes
      match /scenes/{sceneId} {
        allow read, write: if isAuthenticated() && (
          get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid
        );
      }
    }

    // Characters
    match /characters/{characterId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Credit transactions: Read-only for owner, immutable
    match /creditTransactions/{transactionId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
      allow write: if false; // Only server writes credit transactions
    }

    // Generation jobs
    match /generations/{jobId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }

    // Assets
    match /assets/{assetId} {
      allow read, write: if isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid);
    }
  }
}
